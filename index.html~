  .foot-grid h4 { margin: 0 0 14px; font-size: 0.85rem; opacity: 0.7; font-weight: 500; }
  .foot-grid ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 10px; }
  .foot-grid a { text-decoration: none; font-size: 0.95rem; }
