  .join { background: var(--paper-alt); color: var(--ink); }
  .join .section-head h2 { color: var(--ink); }
  .join .kicker { color: var(--orange); }
  .join-grid { max-width: 1120px; margin: 0 auto; display: grid; gap: 40px; }
  .join-grid p { opacity: 0.85; max-width: 42ch; }
  form { display: grid; gap: 14px; }
